{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kaiwu:app-manifest:1",
  "title": "Kaiwu app manifest v1 (Proposed ADR 0045)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "object",
      "minProperties": 1,
      "required": [
        "zh-CN"
      ],
      "propertyNames": {
        "pattern": "^[a-z]{2,3}-[A-Z]{2}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "platform": {
      "type": "string",
      "pattern": "^>=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*) <(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9:-]{1,63}$"
      }
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "service",
              "web"
            ]
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
          },
          "memory": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(Mi|Gi)$"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "health": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9_/-]+$"
          },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,63}$"
              },
              "migrations": {
                "const": true
              }
            },
            "required": [
              "schema",
              "migrations"
            ]
          },
          "route": {
            "type": "string",
            "pattern": "^/[a-z0-9/-]+/\\*\\*$"
          },
          "entry": {
            "type": "string",
            "pattern": "^/apps/[a-z][a-z0-9-]*/$"
          },
          "scope": {
            "const": "platform"
          }
        },
        "required": [
          "kind",
          "image",
          "memory",
          "scope"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "service"
                }
              }
            },
            "then": {
              "required": [
                "port",
                "health",
                "database",
                "route"
              ],
              "not": {
                "required": [
                  "entry"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "web"
                }
              }
            },
            "then": {
              "required": [
                "entry"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "database"
                    ]
                  },
                  {
                    "required": [
                      "route"
                    ]
                  },
                  {
                    "required": [
                      "port"
                    ]
                  },
                  {
                    "required": [
                      "health"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "service"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "web"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceCompose": {
              "const": "deploy/server/compose.yml"
            },
            "webCompose": {
              "const": "web/deploy/server/compose.yml"
            },
            "gatewayRoute": {
              "const": "deploy/server/gateway-route.yml"
            }
          },
          "required": [
            "serviceCompose",
            "webCompose",
            "gatewayRoute"
          ]
        }
      },
      "required": [
        "docker"
      ]
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "menus": {
          "const": "kaiwu/menus.yml"
        },
        "dicts": {
          "const": "kaiwu/dicts.yml"
        },
        "roles": {
          "const": "kaiwu/roles.yml"
        },
        "configs": {
          "const": "kaiwu/configs.yml"
        },
        "i18n": {
          "const": "kaiwu/i18n.yml"
        },
        "jobs": {
          "const": "kaiwu/jobs.yml"
        },
        "data-scopes": {
          "const": "kaiwu/data-scopes.yml"
        }
      },
      "required": [
        "menus",
        "dicts",
        "roles"
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "docs": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_./-]+$"
        }
      },
      "required": [
        "docs"
      ]
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "component": {
              "const": "service"
            },
            "path": {
              "const": "/internal/apps/uninstall-blockers"
            }
          },
          "required": [
            "component",
            "path"
          ]
        }
      },
      "required": [
        "blockers"
      ]
    },
    "tenancy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "supported"
      ],
      "properties": {
        "default": {
          "const": "shared"
        },
        "supported": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "shared",
              "dedicated"
            ]
          },
          "contains": {
            "const": "shared"
          }
        }
      }
    },
    "dedicatedTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "service"
        },
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi)$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "health": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9_/-]+$"
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,63}$"
            },
            "migrations": {
              "const": true
            }
          },
          "required": [
            "schema",
            "migrations"
          ]
        },
        "route": {
          "type": "string",
          "pattern": "^/[a-z0-9/-]+/\\*\\*$"
        },
        "scope": {
          "const": "dedicated-template"
        }
      },
      "required": [
        "kind",
        "scope",
        "image",
        "memory",
        "port",
        "health",
        "database",
        "route"
      ]
    },
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startsPerMinute",
        "inFlightInstances",
        "documentConcurrency"
      ],
      "properties": {
        "startsPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "inFlightInstances": {
          "type": "integer",
          "minimum": 1
        },
        "documentConcurrency": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "formatVersion",
    "code",
    "name",
    "version",
    "platform",
    "requires",
    "components",
    "deployment",
    "manifests",
    "integration",
    "uninstall",
    "tenancy",
    "quotas"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "tenancy": {
            "properties": {
              "supported": {
                "contains": {
                  "const": "dedicated"
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "dedicatedTemplate"
        ]
      }
    }
  ]
}
